# macOS Finder data: rewritten by the system, not part of the game
.DS_Store

# Raw video downloads (HEVC with sound): the game uses the converted copies in "assets/video/"
videos\ /

# The user's Google Flow takes (with sound and the Gemini sparkle): the game uses the films tools/flow_import.py makes
# from them in "assets/video/"
flow\ video\ new/

# Python's compiled copies of the tools
__pycache__/

# Half-finished downloads and conversions
*.part
*.part.*

# Stray copies this synced Desktop folder leaves when a file is written over or renamed ("name 2.png", "main 2")
* [2-9]
* [2-9].*
